{
  "expo": {
    "name": "Mini LMS",
    "slug": "mini-lms",
    "version": "1.0.0",
    "orientation": "default",
    "scheme": "mini-lms",
    "userInterfaceStyle": "automatic",

    "icon": "./assets/icon.png",

    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0f172a"
    },

    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.minilms.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#ffffff"
      },
      "package": "com.minilms.app"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#ffffff"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "c2a38ef8-9733-430f-963f-a8fb79601254"
      }
    }
  }
}
